# Salin file ini ke .env lalu sesuaikan. JANGAN commit .env.

# URL koneksi PostgreSQL. Wajib di production.
DATABASE_URL=postgresql://localhost:5432/hono_react_starter

# Rahasia Better Auth (min 32 karakter). Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin publik aplikasi. Wajib di production dan harus https://
# (dipakai untuk trusted origin/CSRF dan cookie Secure).
BETTER_AUTH_URL=http://localhost:3000

# Port server (opsional, default 3000)
# PORT=3000

# Database untuk `bun test` (opsional). Bila kosong, dipakai DATABASE_URL
# dengan akhiran `_test` pada nama database. Buat dengan: bun run db:test:create
# TEST_DATABASE_URL=postgresql://localhost:5432/hono_react_starter_test

# Akun admin untuk `bun run db:seed` (wajib diisi di production)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Rate limit API umum (/api/* selain /api/auth yang punya limiter sendiri).
# Per IP, store PostgreSQL (dibagi antar instance). 0 = nonaktif.
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW=60

# Logging (lihat src/server/lib/logger.ts)
# LOG_LEVEL=info        # debug | info | warn | error | silent (default: prod info, dev debug, test silent)
# LOG_FORMAT=json       # json | pretty (default: prod json, lainnya pretty)
