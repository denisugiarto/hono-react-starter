# Salin file ini ke apps/api/.env lalu sesuaikan. JANGAN commit .env.
# Semua variabel di bawah dibaca backend (apps/api); frontend (apps/web) tidak butuh .env.

# URL koneksi PostgreSQL. Wajib di production.
DATABASE_URL=postgresql://localhost:5432/hono_react_starter

# Rahasia Better Auth (min 32 karakter). Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin publik aplikasi. Wajib di production dan harus https://
# (dipakai untuk trusted origin/CSRF dan cookie Secure).
BETTER_AUTH_URL=http://localhost:3000

# Port server API (opsional, default 3000). Vite dev (apps/web) memproxy /api ke sini.
# PORT=3000

# Origin lain yang dipercaya Better Auth (CSRF), dipisah koma. Default di luar
# production: http://localhost:5173 (Vite dev server). Di production default kosong.
# TRUSTED_ORIGINS=http://localhost:5173

# Database untuk `bun test` (opsional). Bila kosong, dipakai DATABASE_URL
# dengan akhiran `_test` pada nama database. Buat dengan: bun run db:test:create
# TEST_DATABASE_URL=postgresql://localhost:5432/hono_react_starter_test

# Akun admin untuk `bun run db:seed` (wajib diisi di production)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# Rate limit API umum (/api/* selain /api/auth yang punya limiter sendiri).
# Per IP, store PostgreSQL (dibagi antar instance). 0 = nonaktif.
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW=60

# Email (verifikasi email & reset password). Provider:
#   console = tidak dikirim, isi email (termasuk tautan) dicatat di log  ← default dev
#   resend  = HTTP API Resend (https://resend.com) — butuh RESEND_API_KEY + MAIL_FROM
#   memory  = ditangkap di memori (otomatis saat test)
# MAIL_PROVIDER=console
# MAIL_FROM=Hono React Starter <no-reply@example.com>
# RESEND_API_KEY=re_xxxxxxxx

# Wajibkan verifikasi email sebelum bisa masuk (default false).
# Di production hanya boleh true bila MAIL_PROVIDER=resend.
# AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Logging (lihat apps/api/src/lib/logger.ts)
# LOG_LEVEL=info        # debug | info | warn | error | silent (default: prod info, dev debug, test silent)
# LOG_FORMAT=json       # json | pretty (default: prod json, lainnya pretty)
