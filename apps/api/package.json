{
  "name": "@hono-react-starter/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Backend Hono (Bun): API, Better Auth, Drizzle/PostgreSQL; di production juga menyajikan hasil build apps/web",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/db/migrate.ts && NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "test": "bun test --preload ./tests/setup.ts ./tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts",
    "db:test:create": "createdb hono_react_starter_test"
  },
  "nx": {
    "name": "api",
    "implicitDependencies": [
      "web"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "TEST_DATABASE_URL"
          },
          {
            "env": "DATABASE_URL"
          }
        ]
      }
    }
  },
  "dependencies": {
    "@hono-react-starter/shared": "workspace:*",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "hono-rate-limiter": "^0.5.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10"
  }
}
