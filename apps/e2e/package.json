{
  "name": "@hono-react-starter/e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Test end-to-end Playwright: browser asli terhadap apps/api yang menyajikan build apps/web + akun demo",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  },
  "nx": {
    "name": "e2e",
    "implicitDependencies": ["api", "web", "shared"],
    "targets": {
      "e2e": {
        "dependsOn": ["web:build"],
        "inputs": ["default", "^production", { "env": "TEST_DATABASE_URL" }, { "env": "E2E_DATABASE_URL" }],
        "outputs": ["{projectRoot}/playwright-report", "{projectRoot}/test-results"],
        "cache": false
      }
    }
  },
  "devDependencies": {
    "@better-auth/utils": "^0.3.0",
    "@hono-react-starter/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3"
  }
}
