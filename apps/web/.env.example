# Dibaca Vite saat build/dev (prefix VITE_). Salin ke apps/web/.env bila perlu.

# Base URL API bila frontend di-host terpisah dari backend (CDN/static hosting).
# Kosong = same-origin (dev: proxy Vite ke :3000; production: API menyajikan dist).
# Origin frontend harus ada di TRUSTED_ORIGINS backend.
# VITE_API_URL=https://api.example.com
