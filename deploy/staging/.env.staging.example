# Salin ke .env.staging di root repo (jangan di-commit) lalu:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build

# Domain publik staging (DNS A/AAAA → server ini). Caddy mengurus sertifikat.
STAGING_DOMAIN=staging.example.com

# Rahasia Better Auth khusus staging (min 32 karakter): openssl rand -base64 32
BETTER_AUTH_SECRET=

# Password PostgreSQL internal (opsional, default postgres)
# POSTGRES_PASSWORD=

# Email: default console (hanya log). Untuk uji email sungguhan:
# MAIL_PROVIDER=resend
# MAIL_FROM=Staging <no-reply@staging.example.com>
# RESEND_API_KEY=re_xxx

# LOG_LEVEL=debug
