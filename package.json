{
  "name": "hono-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "start": "nx run api:start",
    "preview": "bun run build && bun run start",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "e2e": "nx run e2e:e2e",
    "e2e:ui": "bun run --cwd apps/e2e e2e:ui",
    "check": "nx run-many -t typecheck lint test",
    "affected": "nx affected -t typecheck lint test build",
    "graph": "nx graph",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:push": "bun run --cwd apps/api db:push",
    "db:studio": "bun run --cwd apps/api db:studio",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:seed:demo": "bun run --cwd apps/api db:seed:demo",
    "db:test:create": "bun run --cwd apps/api db:test:create"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "nx": "^24.0.2",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "lodash": "^4.18.1",
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1"
  }
}
